# Copy to .env and fill in. On cPanel you can also set these in "Setup Node.js App" > Environment variables.
PORT=4000
NODE_ENV=production

# MySQL (create the DB + user in cPanel > MySQL Databases; cPanel prefixes names, e.g. cpuser_leap)
DB_HOST=localhost
DB_PORT=3306
DB_USER=cpuser_leap
DB_PASSWORD=change-me
DB_NAME=cpuser_leap

# Long random string, e.g. from: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Optional: creates the first admin on startup if none exists (remove the password once you've signed in)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Only needed if the React app is served from a different domain than the API
CORS_ORIGIN=
